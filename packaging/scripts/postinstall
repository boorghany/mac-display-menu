#!/bin/sh
# Start the app now for the person who is logged in. launchd starts it at every later login.
LABEL=io.github.boorghany.macdisplaymenu
AGENT="/Library/LaunchAgents/$LABEL.plist"
USER_ID=$(stat -f %u /dev/console)
chown root:wheel "$AGENT"
chmod 644 "$AGENT"
if [ "$USER_ID" != "0" ]; then
  launchctl bootstrap "gui/$USER_ID" "$AGENT" 2>/dev/null || launchctl kickstart -k "gui/$USER_ID/$LABEL"
fi
exit 0
